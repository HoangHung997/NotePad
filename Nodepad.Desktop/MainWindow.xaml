<Window x:Class="Nodepad.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nodepad Explorer"
        Icon="/Assets/Branding/h2-notes-app-icon-v1.png"
        Width="1220"
        Height="800"
        MinWidth="1040"
        MinHeight="680"
        Background="{StaticResource AppCanvasBrush}"
        Closing="MainWindow_OnClosing"
        StateChanged="MainWindow_OnStateChanged">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="26"
                Padding="18"
                Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Nodepad"
                               FontFamily="Georgia"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Desktop notes first. Projects live in one hub note."
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <TextBox Grid.Row="1"
                         Margin="0,18,0,0"
                         Text="{Binding Settings.SearchText, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="SearchBox_OnTextChanged" />

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Button Content="New sticky note"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="NewGeneralNoteButton_OnClick"
                            Margin="0,0,0,10" />
                    <Button Content="Open project hub"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OpenProjectHubButton_OnClick" />
                </StackPanel>

                <ScrollViewer Grid.Row="3"
                              Margin="0,18,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Workspace"
                                   Margin="0,0,0,10"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <Button x:Name="DesktopFilterButton"
                                Tag="desktop"
                                Style="{StaticResource SidebarFilterButtonStyle}"
                                Click="FilterButton_OnClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="On desktop" />
                                <TextBlock x:Name="DesktopCountText" Grid.Column="1" />
                            </Grid>
                        </Button>

                        <Button x:Name="NotesFilterButton"
                                Tag="notes"
                                Style="{StaticResource SidebarFilterButtonStyle}"
                                Click="FilterButton_OnClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="General notes" />
                                <TextBlock x:Name="NotesCountText" Grid.Column="1" />
                            </Grid>
                        </Button>

                        <Button x:Name="ProjectsFilterButton"
                                Tag="projects"
                                Style="{StaticResource SidebarFilterButtonStyle}"
                                Click="FilterButton_OnClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Project hub" />
                                <TextBlock x:Name="ProjectsCountText" Grid.Column="1" />
                            </Grid>
                        </Button>

                        <Button x:Name="StarredFilterButton"
                                Tag="starred"
                                Style="{StaticResource SidebarFilterButtonStyle}"
                                Click="FilterButton_OnClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Starred" />
                                <TextBlock x:Name="StarredCountText" Grid.Column="1" />
                            </Grid>
                        </Button>

                        <Button x:Name="HiddenFilterButton"
                                Tag="hidden"
                                Style="{StaticResource SidebarFilterButtonStyle}"
                                Click="FilterButton_OnClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Hidden" />
                                <TextBlock x:Name="HiddenCountText" Grid.Column="1" />
                            </Grid>
                        </Button>

                        <Button x:Name="ArchivedFilterButton"
                                Tag="archived"
                                Style="{StaticResource SidebarFilterButtonStyle}"
                                Click="FilterButton_OnClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Archived" />
                                <TextBlock x:Name="ArchivedCountText" Grid.Column="1" />
                            </Grid>
                        </Button>

                        <Border Margin="0,18,0,0"
                                Padding="14"
                                Background="{StaticResource PanelAltBrush}"
                                CornerRadius="18">
                            <StackPanel>
                                <TextBlock Text="Defaults for new notes"
                                           FontFamily="Segoe UI Semibold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Keep the explorer light; tune defaults here once."
                                           Margin="0,6,0,12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />

                                <TextBlock Text="Color"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <ComboBox ItemsSource="{Binding PaletteOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding Settings.DefaultPaletteKey, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionChanged="SettingsControl_OnChanged"
                                          Margin="0,6,0,10" />

                                <TextBlock Text="Font"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <ComboBox ItemsSource="{Binding FontOptions}"
                                          SelectedItem="{Binding Settings.DefaultFontFamily, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionChanged="SettingsControl_OnChanged"
                                          Margin="0,6,0,10" />

                                <TextBlock Text="Size"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <ComboBox ItemsSource="{Binding FontSizeOptions}"
                                          SelectedItem="{Binding Settings.DefaultFontSize, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionChanged="SettingsControl_OnChanged"
                                          Margin="0,6,0,10" />

                                <CheckBox Content="Restore desktop notes on startup"
                                          IsChecked="{Binding Settings.ShowNotesOnStartup, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="SettingsControl_OnChanged"
                                          Unchecked="SettingsControl_OnChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="4"
                        Margin="0,16,0,0"
                        Padding="12"
                        Background="{StaticResource PanelAltBrush}"
                        CornerRadius="16">
                    <TextBlock Text="Close this explorer to send it to tray. Your desktop notes stay alive."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="30"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="WorkspaceTitleText"
                                   FontFamily="Georgia"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="WorkspaceSubtitleText"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button x:Name="ProjectListViewButton"
                                Content="List"
                                Tag="list"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="ProjectViewModeButton_OnClick"
                                Margin="0,0,10,0"
                                Visibility="Collapsed" />
                        <Button x:Name="ProjectBoardViewButton"
                                Content="Board"
                                Tag="board"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="ProjectViewModeButton_OnClick"
                                Margin="0,0,10,0"
                                Visibility="Collapsed" />
                        <Button x:Name="LaunchProjectHubButton"
                                Content="Open project hub"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="LaunchProjectHubButton_OnClick"
                                Margin="0,0,10,0"
                                Visibility="Collapsed" />
                        <Button Content="Show all"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="ShowAllButton_OnClick"
                                Margin="0,0,10,0" />
                        <Button Content="Hide all"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="HideAllButton_OnClick" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock x:Name="EmptyStateText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Georgia"
                               FontSize="22"
                               Foreground="{StaticResource MutedTextBrush}"
                               Visibility="Collapsed" />

                    <ScrollViewer x:Name="CardsPane"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ExplorerNotesView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="220"
                                            Margin="0,0,16,16"
                                            Padding="14"
                                            CornerRadius="18"
                                            Background="{Binding NoteBackgroundHex, Converter={StaticResource HexToBrushConverter}}"
                                            BorderBrush="{Binding NoteBorderHex, Converter={StaticResource HexToBrushConverter}}"
                                            BorderThickness="1.2"
                                            MouseLeftButtonDown="NoteCard_OnMouseLeftButtonDown">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <DockPanel>
                                                <Border Background="{Binding NoteSurfaceHex, Converter={StaticResource HexToBrushConverter}}"
                                                        Padding="8,4"
                                                        CornerRadius="10"
                                                        DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding DesktopLabel}"
                                                               FontFamily="Segoe UI Semibold"
                                                               FontSize="11"
                                                               Foreground="{Binding NoteAccentHex, Converter={StaticResource HexToBrushConverter}}" />
                                                </Border>
                                                <TextBlock Text="{Binding UpdatedLabel}"
                                                           Margin="8,2,0,0"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{Binding NoteForegroundHex, Converter={StaticResource HexToBrushConverter}}"
                                                           Opacity="0.65" />
                                            </DockPanel>

                                            <TextBlock Grid.Row="1"
                                                       Margin="0,12,0,8"
                                                       Text="{Binding DisplayTitle}"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Georgia"
                                                       FontSize="19"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding NoteForegroundHex, Converter={StaticResource HexToBrushConverter}}" />

                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding SummaryLabel}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding NoteForegroundHex, Converter={StaticResource HexToBrushConverter}}" />
                                                <TextBlock Text="{Binding Tags}"
                                                           Margin="0,8,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding NoteForegroundHex, Converter={StaticResource HexToBrushConverter}}"
                                                           Opacity="0.7" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        Margin="0,12,0,0">
                                                <Button Content="Open"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Click="CardOpenButton_OnClick"
                                                        Margin="0,0,8,0" />
                                                <Button Content="{Binding DesktopLabel}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Click="CardToggleDesktopButton_OnClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid x:Name="ProjectsPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="16"
                                Margin="0,0,0,16"
                                Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="One sticky note for all projects"
                                               FontFamily="Georgia"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Board is for scanning. List is for details. The current action always comes from the first unfinished checklist item."
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Open hub note"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Click="LaunchProjectHubButton_OnClick"
                                        Margin="16,0,0,0" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="ProjectsListPane"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding VisibleProjects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      Expanded="ProjectExpander_OnExpanded"
                                                      Collapsed="ProjectExpander_OnCollapsed"
                                                      Margin="0,0,0,12">
                                                <Expander.Header>
                                                    <Border Padding="16"
                                                            Background="{StaticResource PanelAltBrush}"
                                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="18">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontFamily="Georgia"
                                                                           FontSize="22"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource TextBrush}" />
                                                                <TextBlock Text="{Binding HeaderLine}"
                                                                           Margin="0,6,0,0"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontFamily="Segoe UI Semibold" />
                                                                <TextBlock Text="{Binding Preview}"
                                                                           Margin="0,6,0,0"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1"
                                                                        Margin="16,0,0,0">
                                                                <Button Content="Open hub"
                                                                        Style="{StaticResource GhostButtonStyle}"
                                                                        Click="LaunchProjectHubButton_OnClick"
                                                                        Margin="0,0,0,8"
                                                                        VerticalAlignment="Top" />
                                                                <Button Content="Done next"
                                                                        Style="{StaticResource GhostButtonStyle}"
                                                                        Click="ProjectDoneNextButton_OnClick"
                                                                        Margin="0,0,0,8" />
                                                                <Button Content="To note"
                                                                        Style="{StaticResource GhostButtonStyle}"
                                                                        Click="ProjectMoveToNoteButton_OnClick" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Expander.Header>

                                                <Border Margin="12,10,12,0"
                                                        Padding="16"
                                                        CornerRadius="18"
                                                        Background="{StaticResource PanelAltBrush}"
                                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Checklist"
                                                                   FontFamily="Segoe UI Semibold"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource TextBrush}" />

                                                        <ItemsControl ItemsSource="{Binding ChecklistItems}" Margin="0,10,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <CheckBox IsChecked="{Binding IsCompleted}"
                                                                                  IsEnabled="False"
                                                                                  VerticalAlignment="Top"
                                                                                  Margin="0,3,10,0" />

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding DisplayText}"
                                                                                   TextWrapping="Wrap"
                                                                                   Foreground="{StaticResource TextBrush}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                            <Setter Property="Opacity" Value="0.65" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Border Margin="0,14,0,0"
                                                                Padding="12"
                                                                Background="{StaticResource PanelBrush}"
                                                                CornerRadius="14">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Preview}"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{StaticResource TextBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer x:Name="ProjectsBoardPane"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="Collapsed">
                                <ItemsControl ItemsSource="{Binding VisibleProjects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="250"
                                                    Margin="0,0,16,16"
                                                    Padding="14"
                                                    CornerRadius="18"
                                                    Background="{StaticResource PanelAltBrush}"
                                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontFamily="Georgia"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextBrush}" />

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding HeaderLine}"
                                                               Margin="0,8,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontFamily="Segoe UI Semibold" />

                                                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                                        <TextBlock Text="{Binding Preview}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                    </StackPanel>

                                                    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                                                        <Button Content="Open hub"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Click="LaunchProjectHubButton_OnClick"
                                                                Margin="0,0,8,8" />
                                                        <Button Content="Done next"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Click="ProjectDoneNextButton_OnClick"
                                                                Margin="0,0,8,8" />
                                                        <Button Content="To note"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Click="ProjectMoveToNoteButton_OnClick"
                                                                Margin="0,0,8,8" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
