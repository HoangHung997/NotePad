.artifacts/
artifacts/
releases/
TestResults/
coverage/
.cache/

# Package/cache directories
node_modules/
packages/

# Temporary files
*.tmp
*.temp
*.log
*.cache
*.bak

# Local secrets / credentials
.env
.env.*
secrets.json
credentials.json
*.pfx
