<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="H2AgentLab.LabApp" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="Background" Value="#FCFAF7"/><Setter Property="Foreground" Value="#302E2B"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="13,8"/><Setter Property="Background" Value="#F6EFE6"/><Setter Property="BorderBrush" Value="#D9CFC5"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#A4573D"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.primary /template/ ContentPresenter"><Setter Property="Background" Value="#A4573D"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D9CFC5"/></Style>
  </Application.Styles>
</Application>
