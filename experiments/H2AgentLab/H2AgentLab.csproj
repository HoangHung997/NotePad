<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>../../assets/branding/h2-notes-app-icon-v1.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Update="skills/**/*;runtime/**/*;runtime-guide.md;skill-sources/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <ProjectReference Include="../../src/H2Notes.Core/H2Notes.Core.csproj" />
    <ProjectReference Include="../H2AgentLab.OfficeProtocol/H2AgentLab.OfficeProtocol.csproj" />
    <ProjectReference Include="../H2AgentLab.DesktopProtocol/H2AgentLab.DesktopProtocol.csproj" />
    <ProjectReference Include="../H2AgentLab.DesktopHost/H2AgentLab.DesktopHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyDesktopHostAfterBuild" AfterTargets="Build">
    <ItemGroup>
      <DesktopHostArtifacts Include="../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.exe"
                            Condition="Exists('../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.exe')" />
      <DesktopHostArtifacts Include="../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.dll"
                            Condition="Exists('../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.dll')" />
      <DesktopHostArtifacts Include="../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.deps.json"
                            Condition="Exists('../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.deps.json')" />
      <DesktopHostArtifacts Include="../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.runtimeconfig.json"
                            Condition="Exists('../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(DesktopHostArtifacts)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDesktopHostAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <DesktopHostPublishArtifacts Include="../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.exe"
                                   Condition="Exists('../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.exe')" />
      <DesktopHostPublishArtifacts Include="../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.dll"
                                   Condition="Exists('../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.dll')" />
      <DesktopHostPublishArtifacts Include="../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.deps.json"
                                   Condition="Exists('../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.deps.json')" />
      <DesktopHostPublishArtifacts Include="../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.runtimeconfig.json"
                                   Condition="Exists('../H2AgentLab.DesktopHost/bin/$(Configuration)/net10.0-windows/H2AgentLab.DesktopHost.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(DesktopHostPublishArtifacts)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
