<Window x:Class="Nodepad.Desktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="/Assets/Branding/h2-notes-app-icon-v1.png"
        Width="980"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppCanvasBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Settings"
                       FontFamily="Georgia"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" />

            <TextBlock Grid.Row="1"
                       Margin="0,10,0,26"
                       Text="App-wide behavior and defaults for new notes."
                       Foreground="{StaticResource MutedTextBrush}" />

            <TextBlock Grid.Row="2"
                       Text="General"
                       FontFamily="Segoe UI Semibold"
                       FontSize="16"
                       Foreground="{StaticResource TextBrush}" />

            <StackPanel Grid.Row="3"
                        Margin="0,14,0,28">
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Run on system start"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="14" />
                            <TextBlock Text="Launch Nodepad when you sign in to Windows."
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Content="On"
                                  IsChecked="{Binding Settings.RunOnSystemStart, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Show notes when the program starts"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="14" />
                            <TextBlock Text="Restore desktop notes automatically on app startup."
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Content="On"
                                  IsChecked="{Binding Settings.ShowNotesOnStartup, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="4"
                       Text="Personalization"
                       FontFamily="Segoe UI Semibold"
                       FontSize="16"
                       Foreground="{StaticResource TextBrush}" />

            <StackPanel Grid.Row="5"
                        Margin="0,14,0,28">
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Default note color"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="14" />
                            <TextBlock Text="Choose the palette for newly created notes."
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PaletteOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding Settings.DefaultPaletteKey, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Default note font"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="14" />
                            <TextBlock Text="Set the default font for new notes."
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FontOptions}"
                                  SelectedItem="{Binding Settings.DefaultFontFamily, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Default note size"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="14" />
                            <TextBlock Text="Choose the default text size for new notes."
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FontSizeOptions}"
                                  SelectedItem="{Binding Settings.DefaultFontSize, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Profile name"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="14" />
                            <TextBlock Text="Shown in explorer and other personal labels."
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Workspace headline"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="14" />
                            <TextBlock Text="A short description for the explorer home panel."
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.WorkspaceLabel, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="72"
                                 VerticalContentAlignment="Top" />
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="6"
                    Padding="14"
                    CornerRadius="18"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1">
                <TextBlock Text="These settings apply globally. Note-specific options such as color, opacity, and pin stay in each note."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Border>

            <StackPanel Grid.Row="7"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Close"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CloseButton_OnClick" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
