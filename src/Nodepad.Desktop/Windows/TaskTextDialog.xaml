<Window x:Class="Nodepad.Desktop.Windows.TaskTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Task"
        Icon="/Assets/Branding/h2-notes-app-icon-v1.png"
        Width="420"
        Height="210"
        MinWidth="420"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
            WindowStyle="None"
    
        Background="{StaticResource PanelBrush}">
    <Border
            Padding="10"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1">
        <Grid Height="200" VerticalAlignment="Center" Margin="0,0,-9,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Add Checklist"
                           FontFamily="Georgia"
                           FontSize="11"
                           FontWeight="Bold"
                 />
            </StackPanel>

            <TextBox x:Name="TaskTextBox"
                     Margin="0,20,0,37"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="True" Grid.RowSpan="3" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="CancelButton_OnClick"
                        IsCancel="True" Height="29" Padding="16,2,16,2" />
                <Button Content="OK"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OkButton_OnClick"
                        IsDefault="True" Height="29" FontSize="12" Padding="16,2,16,2" Grid.IsSharedSizeScope="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
