<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="H2Notes.Avalonia.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="#302E2B" />
      <Setter Property="Background" Value="#FCFAF7" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="#FAF6F1" />
      <Setter Property="BorderBrush" Value="#D9CFC5" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="ToggleButton.format">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ToggleButton.format:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F6E2D7" />
      <Setter Property="BorderBrush" Value="#C58B72" />
      <Setter Property="Foreground" Value="#A4573D" />
    </Style>
    <Style Selector="ToggleButton.format:indeterminate /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F5EACC" />
      <Setter Property="BorderBrush" Value="#B69750" />
      <Setter Property="Foreground" Value="#59471E" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="#D6CEC5" />
      <Setter Property="Background" Value="#FCFDFC" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#A4573D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#A4573D"/>
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A4573D"/><Setter Property="BorderBrush" Value="#A4573D"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#A4573D"/><Setter Property="BorderBrush" Value="#A4573D"/>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="4,12"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#F9EAE2"/><Setter Property="Foreground" Value="#A4573D"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="6,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F7E8DF"/><Setter Property="BorderBrush" Value="#A4573D"/><Setter Property="BorderThickness" Value="3,0,0,0"/>
    </Style>
  </Application.Styles>
</Application>
